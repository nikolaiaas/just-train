# Public client configuration. These local values are for an explicit Safari
# integration run only. A physical phone must use hosted Development over HTTPS.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Never add OPENROUTER_API_KEY or a Supabase secret/service-role key here.
