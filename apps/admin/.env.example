# Public Supabase configuration. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional, server-only local CLI backend for the selector shown exclusively on
# http://localhost:11000 and http://127.0.0.1:11000 in development.
# SUPABASE_LOCAL_URL=http://127.0.0.1:54321
# SUPABASE_LOCAL_PUBLISHABLE_KEY=your-local-publishable-key

# Optional outside Vercel. Must be the exact HTTPS origin allowed by Supabase
# Auth, with no path (for example https://admin.example.com).
# ADMIN_PUBLIC_ORIGIN=https://admin.example.com

# Server only. Never rename this to NEXT_PUBLIC_OPENROUTER_API_KEY.
# OPENROUTER_API_KEY=your-openrouter-api-key
