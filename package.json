{
  "name": "bare-traen",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:console": "pnpm --dir tools/dev-console build && node tools/dev-console/server/index.mjs",
    "dev": "concurrently -n admin,mobile -c blue,green \"pnpm dev:admin\" \"pnpm dev:mobile\"",
    "dev:admin": "pnpm --filter @bare-traen/admin dev",
    "dev:mobile": "pnpm --filter @bare-traen/mobile start",
    "dev:web": "concurrently -k -n admin,mobile-web -c blue,green \"pnpm dev:admin\" \"pnpm --filter @bare-traen/mobile exec expo start --web --lan --port 11001\"",
    "dev:iphone": "pnpm --filter @bare-traen/mobile exec expo start --dev-client --lan --port 11001",
    "dev:iphone:tunnel": "pnpm --filter @bare-traen/mobile exec expo start --dev-client --tunnel --port 11001",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test && pnpm test:supabase-config && pnpm test:dev-console",
    "test:dev-console": "pnpm --dir tools/dev-console build && node --test tools/dev-console/test/*.test.mjs",
    "test:supabase-auth": "node --test supabase/tests/passwordless-auth.integration.test.mjs",
    "test:supabase-config": "node --test supabase/tests/passwordless-config.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "supabase:lint": "supabase db lint --local --schema public,private --level warning --fail-on error",
    "supabase:types": "supabase gen types typescript --local > packages/domain/src/database.generated.ts && prettier --write packages/domain/src/database.generated.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "supabase": "^2.39.2"
  }
}
